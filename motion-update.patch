+'use client';
+
+import { useEffect, useRef } from 'react';
+import { gsap } from 'gsap';
+import { ScrollTrigger } from 'gsap/ScrollTrigger';
+
+/** Progressive enhancement: the server-rendered page stays visible without JS. */
+export function PortfolioChoreography() {
+  const progress = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const main = document.querySelector('main');
+    const hero = document.querySelector<HTMLElement>('.hero');
+    if (!main || !hero || !progress.current) return;
+
+    gsap.registerPlugin(ScrollTrigger);
+    const media = gsap.matchMedia();
+
+    media.add('(prefers-reduced-motion: no-preference)', () => {
+      let disposed = false;
+      let refreshFrame = 0;
+      const entrances: { element: HTMLElement; tween: gsap.core.Tween }[] = [];
+      const refresh = () => {
+        if (disposed || refreshFrame) return;
+        refreshFrame = requestAnimationFrame(() => {
+          refreshFrame = 0;
+          ScrollTrigger.refresh();
+        });
+      };
+
+      // Do not replay the introduction over a deep link or a restored scroll position.
+      const intro = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.8 } });
+      if (window.scrollY < 40 && (!location.hash || location.hash === '#home')) {
+        intro
+          .from('.hero-copy > .hello', { y: 16, opacity: 0, clearProps: 'transform,opacity' })
+          .from('.hero-copy > h1', { y: 26, opacity: 0, clearProps: 'transform,opacity' }, 0.12)
+          .from('.hero-copy > .rotating-role, .hero-copy > p', {
+            y: 18, opacity: 0, stagger: 0.1, clearProps: 'transform,opacity',
+          }, 0.26)
+          .from('.hero-copy > .actions, .hero-copy > .socials', {
+            y: 14, opacity: 0, stagger: 0.08, clearProps: 'transform,opacity',
+          }, 0.42)
+          .from('.hero-art', { y: 24, opacity: 0, duration: 1.1, clearProps: 'transform,opacity' }, 0.18);
+      }
+
+      const groups = [
+        '.capabilities > div', '.about .polaroid, .about .about-copy > h2, .about .idea-note',
+        '.skills', '.journey > .paper', '.projects', '.studio > div', '.philosophy',
+        '.personal-editorial', '.contact-copy', '.contact-workspace', '.contact-inline',
+      ];
+
+      groups.forEach(selector => {
+        gsap.utils.toArray<HTMLElement>(selector).forEach((element, index) => {
+          // Content already in view remains in place, including hash-link targets.
+          if (element.getBoundingClientRect().top < window.innerHeight * 0.94) return;
+          const tween = gsap.fromTo(element, { y: 22, opacity: 0.4 }, {
+            y: 0, opacity: 1, duration: 0.7, delay: Math.min(index * 0.08, 0.24),
+            ease: 'power2.out', clearProps: 'transform,opacity',
+            scrollTrigger: { trigger: element, start: 'top 94%', once: true },
+          });
+          entrances.push({ element, tween });
+        });
+      });
+
+      gsap.fromTo(progress.current, { scaleX: 0 }, {
+        scaleX: 1, ease: 'none',
+        scrollTrigger: { start: 0, end: 'max', scrub: 0.2, invalidateOnRefresh: true },
+      });
+
+      // Keyboard navigation must never wait for an entrance animation.
+      const finishFocused = (event: FocusEvent) => {
+        if (!(event.target instanceof Node)) return;
+        if (hero.contains(event.target)) intro.progress(1);
+        entrances.forEach(({ element, tween }) => {
+          if (element.contains(event.target as Node)) {
+            tween.progress(1);
+            tween.scrollTrigger?.kill();
+          }
+        });
+      };
+      const pauseIntro = () => { intro.paused(document.hidden); };
+      main.addEventListener('focusin', finishFocused);
+      main.addEventListener('load', refresh, true);
+      document.addEventListener('visibilitychange', pauseIntro);
+      const resizeObserver = new ResizeObserver(refresh);
+      resizeObserver.observe(main);
+      void document.fonts.ready.then(refresh);
+      refresh();
+
+      return () => {
+        disposed = true;
+        cancelAnimationFrame(refreshFrame);
+        resizeObserver.disconnect();
+        main.removeEventListener('focusin', finishFocused);
+        main.removeEventListener('load', refresh, true);
+        document.removeEventListener('visibilitychange', pauseIntro);
+      };
+    });
+
+    media.add('(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) and (min-width: 901px)', () => {
+      const collage = hero.querySelector<HTMLImageElement>('.collage');
+      if (!collage) return;
+      const x = gsap.quickTo(collage, 'x', { duration: 0.65, ease: 'power3.out' });
+      const y = gsap.quickTo(collage, 'y', { duration: 0.65, ease: 'power3.out' });
+      const rotate = gsap.quickTo(collage, 'rotation', { duration: 0.65, ease: 'power3.out' });
+      const reset = () => { x(0); y(0); rotate(0); };
+      const move = (event: PointerEvent) => {
+        if (event.pointerType !== 'mouse' || document.hidden) return;
+        const bounds = hero.getBoundingClientRect();
+        const dx = gsap.utils.clamp(-1, 1, ((event.clientX - bounds.left) / bounds.width - 0.5) * 2);
+        const dy = gsap.utils.clamp(-1, 1, ((event.clientY - bounds.top) / bounds.height - 0.5) * 2);
+        x(dx * 8); y(dy * 6); rotate(dx * 0.6);
+      };
+      hero.addEventListener('pointermove', move, { passive: true });
+      hero.addEventListener('pointerleave', reset);
+      window.addEventListener('blur', reset);
+      window.addEventListener('scroll', reset, { passive: true });
+      return () => {
+        hero.removeEventListener('pointermove', move);
+        hero.removeEventListener('pointerleave', reset);
+        window.removeEventListener('blur', reset);
+        window.removeEventListener('scroll', reset);
+      };
+    });
+
+    return () => media.revert();
+  }, []);
+
+  return <div ref={progress} className="reading-progress" aria-hidden="true" />;
+}
